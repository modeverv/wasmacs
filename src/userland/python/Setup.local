# The first Python image is an offline, single-threaded interpreter.
# Do not pull in socket mounts, a dynamic loader, external native libraries,
# GUI bindings, or test extension modules.

# subprocess: the Process Service provides fork, exec, pipes and waitpid.
# configure marks the module n/a for every Emscripten build, so name it here.
*static*
_posixsubprocess _posixsubprocess.c

*disabled*
_socket
_ssl
_hashlib
_ctypes
_decimal
_bz2
_lzma
_zstd
zlib
_sqlite3
_dbm
_gdbm
_tkinter
readline
_multiprocessing
_posixshmem
_asyncio
_remote_debugging
