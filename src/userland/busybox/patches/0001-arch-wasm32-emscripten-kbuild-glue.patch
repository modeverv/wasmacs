--- /dev/null
+++ b/arch/wasm32/Makefile
@@ -0,0 +1,34 @@
+# ==========================================================================
+# wasm32 / Emscripten glue for the BusyBox build system (added by wasmacs).
+#
+#   make ARCH=wasm32 O=<builddir> HOSTCC=cc busybox_unstripped
+#
+# The top-level Makefile does "-include arch/$(ARCH)/Makefile" after the
+# generic tool variables are set and before Makefile.flags is read, so the
+# plain assignments below replace the defaults ($(CROSS_COMPILE)gcc etc.).
+# ==========================================================================
+
+CC         = emcc
+AR         = emar
+NM         = emnm
+STRIP      = true
+OBJCOPY    = true
+OBJDUMP    = true
+SKIP_STRIP = y
+
+# clang accepts-and-ignores a few gcc-only -f flags that Makefile.flags adds
+# through cc-option (one warning per flag per file), and BusyBox uses the
+# "literal"+N idiom on purpose.
+CFLAGS += -Wno-ignored-optimization-argument -Wno-string-plus-int
+
+# The final link is NOT done by Kbuild.  scripts/trylink would run a dozen
+# full emcc links (linker-option probes, then dropping -lm/-lrt/-lcrypt one
+# at a time), and wasmacs needs several differently configured links of the
+# same objects anyway (NODERAWFS test flavour, ASYNCIFY "kernel" flavour).
+# Kbuild only records the link inputs; wasmacs' build.sh links them.
+#
+# Keep this command free of backslashes and quotes: Kbuild saves it with
+# "echo 'cmd_$@ := ...' > .$@.cmd" and re-reads that file as a makefile; on
+# macOS /bin/sh's echo expands "\n", which corrupts the saved command.
+quiet_cmd_busybox__ = LINKIN  $@.inputs
+      cmd_busybox__ = echo $(core-y) $(libs-y) >$@.inputs && touch $@
