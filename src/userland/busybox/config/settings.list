# Explicit non-applet settings for the wasmacs multicall busybox.
# Format: CONFIG_NAME=y | CONFIG_NAME=n | CONFIG_NAME="string" | CONFIG_NAME=123
# Applied by scripts/mkconfig.sh after the applet whitelist (settings win).
# Anything not listed here keeps its Kconfig default.

# ---- build ----
CONFIG_STATIC=n
CONFIG_PIE=n
CONFIG_NOMMU=n
CONFIG_STATIC_LIBGCC=n
CONFIG_CROSS_COMPILER_PREFIX=""
CONFIG_LFS=y
CONFIG_TIME64=y
CONFIG_DEBUG=n
CONFIG_WERROR=n
CONFIG_USE_PORTABLE_CODE=n
CONFIG_SHA1_HWACCEL=n
CONFIG_SHA256_HWACCEL=n

# ---- general behaviour ----
CONFIG_DESKTOP=y
CONFIG_EXTRA_COMPAT=n
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_PAM=n
CONFIG_SELINUX=n
CONFIG_FEATURE_UTMP=n
CONFIG_FEATURE_WTMP=n
CONFIG_FEATURE_PIDFILE=n
CONFIG_FEATURE_SUID=n
CONFIG_FEATURE_SYSLOG_INFO=n
CONFIG_FEATURE_CLEAN_UP=n

# ---- multicall / exec policy ----
CONFIG_FEATURE_INSTALLER=y
CONFIG_FEATURE_VERSION=y
CONFIG_INSTALL_NO_USR=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y

# ---- libc gaps ----
# no <sys/sendfile.h> in the Emscripten sysroot
CONFIG_FEATURE_USE_SENDFILE=n
# musl-in-Emscripten has no getpwnam/getgrgid data source; use BusyBox's own
# /etc/passwd + /etc/group parser
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=n
CONFIG_FEATURE_SHADOWPASSWDS=n
CONFIG_USE_BB_CRYPT=y

# ---- terminal / unicode ----
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=500
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_USERNAME_COMPLETION=n
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_ASK_TERMINAL=n
CONFIG_LOCALE_SUPPORT=n
CONFIG_UNICODE_SUPPORT=y
CONFIG_FEATURE_CHECK_UNICODE_IN_ENV=n
CONFIG_LAST_SUPPORTED_WCHAR=0
CONFIG_UNICODE_COMBINING_WCHARS=y
CONFIG_UNICODE_WIDE_WCHARS=y

# ---- shells ----
# job control needs process groups + tcsetpgrp + SIGTSTP: not provided
CONFIG_ASH_JOB_CONTROL=n
CONFIG_HUSH_JOB=n
CONFIG_ASH_MAIL=n
CONFIG_BASH_IS_NONE=y
