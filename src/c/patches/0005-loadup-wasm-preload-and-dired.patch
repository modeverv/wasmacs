--- a/lisp/loadup.el
+++ b/lisp/loadup.el
@@ -52,6 +52,12 @@
 ;; bidi.c needs for its job.
 (setq redisplay--inhibit-bidi t)
 
+;; wasmacs wasm-O2: suppress GC during cold loadup to avoid wasm-local GC corruption.
+;; Under -O2/-O3 Emscripten builds, the C compiler may keep Lisp_Objects in wasm value-stack
+;; locals that are not scanned by the conservative GC.  Setting a very high threshold
+;; prevents GC from firing while early Lisp files are loaded.
+(setq gc-cons-threshold (* 400 1024 1024))
+
 (message "Dump mode: %s" dump-mode)
 
 ;; Add subdirectories to the load-path for files that might get
@@ -143,6 +149,13 @@
 (load "env")
 (load "format")
 (load "bindings")
+
+;; wasmacs os-compat: Dired without external ls.
+;; Browser MVP keeps host.process unavailable, so directory listing must use
+;; Emacs filesystem primitives through ls-lisp instead of an ls subprocess.
+(load "ls-lisp" nil t)
+(setq ls-lisp-use-insert-directory-program nil)
+(setq insert-directory-program nil)
 (load "window")  ; Needed here for `replace-buffer-in-windows'.
 ;; We are now capable of resizing the mini-windows, so give the
 ;; variable its advertised default value (it starts as nil, see
@@ -644,6 +657,23 @@
           ;; Don't enable this before bootstrap is completed, as the
           ;; compiler infrastructure may not be usable yet.
           (setq native-comp-enable-subr-trampolines t))
+        ;; wasmacs wasm-O2: set a large gc-cons-threshold for interactive use.
+        ;; Default (~800KB) causes excessive GC in the wasm interpreter; 100MB
+        ;; eliminates GC for typical editing workloads.
+        (setq gc-cons-threshold (* 100 1024 1024))
+        (when (equal dump-mode "pbootstrap")
+          ;; wasmacs pbootstrap: preload url fetch lisp before the portable dump.
+          ;; Browser/CI pdmp startup can otherwise overflow the wasm JS call
+          ;; stack while loading these bytecode-heavy Lisp libraries after
+          ;; restore.  Keeping them in the dump makes runtime require shallow.
+          (add-to-list (quote load-path) "/usr/local/share/emacs/30.2/lisp/url")
+          (add-to-list (quote load-path) "/usr/local/share/emacs/30.2/lisp/net")
+          (require (quote json))
+          (require (quote url-methods))
+          (require (quote url-parse))
+          (require (quote url-vars))
+          (require (quote url))
+          (require (quote wasmacs-url-fetch)))
         (message "Dumping under the name %s" output)
         (condition-case ()
             (delete-file output)
