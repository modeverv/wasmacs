+/* wasmacs process service.  There is no fork or exec under wasm.  A
+   subprocess is another wasm program that the host kernel
+   (src/runtime/process/wasmacs-kernel.js) runs inside the same worker;
+   the host starts it, delivers signals to it and reports its status.  */
+extern int wasmacs_host_proc_spawn (char **argv, char **envp, const char *cwd,
+				    int std_in, int std_out, int std_err);
+extern int wasmacs_host_proc_kill (int pid, int sig);
+
+/* kill for subprocesses: PID < 0 names a process group, like kill(2).  */
+int
+wasmacs_os_kill (pid_t pid, int sig)
+{
+  if (pid == getpid ())
+    return raise (sig);
+  int rc = wasmacs_host_proc_kill (pid, sig);
+  if (rc < 0)
+    {
+      errno = -rc;
+      return -1;
+    }
+  return 0;
+}
+# define kill wasmacs_os_kill
+
+/* The host calls this when C-g arrives while Emacs is blocked waiting for
+   a subprocess (reading its output, waitpid, accept-process-output).  On
+   a real terminal the tty driver would have turned the key into SIGINT.  */
+__attribute__ ((used, visibility ("default")))
+void
+wasmacs_os_request_quit (void)
+{
+  Vquit_flag = Qt;
+}
 
+/* The host calls this to run a signal handler of Emacs: the SIGCHLD
+   handler when a subprocess changed state.  */
+__attribute__ ((used, visibility ("default")))
+int
+wasmacs_os_raise_signal (int sig)
+{
+  return raise (sig);
+}
+#endif /* __EMSCRIPTEN__ */
