(byte-code "\300\301\302\303\304DD\305\306\307\310\311&\210\300\312\302\303\313DD\314\315\316\310\317&\210\300\320\302\303\321DD\322\310\311%\210\300\323\302\303\324DD\325\310\311%\210\300\326\302\303\327DD\330\310\311%\207" [custom-declare-variable battery-mode-line-limit funcall function #[0 "\300\207" [100] 1 (#$ . 772)] (#$ . 5700) :version "24.1" :type integer battery-mode-line-format #[0 "\301=\203␀\302\207\205␀\303\207" [battery-status-function battery-linux-proc-acpi "[%b%p%%,%d°C] " "[%b%p%%] "] 2 (#$ . 772)] (#$ . 5774) :link (info-link "(elisp) Custom Format Strings") (choice string (const nil)) battery-update-interval #[0 "\300\207" [60] 1 (#$ . 772)] (#$ . 6689) battery-load-low #[0 "\300\207" [25] 1 (#$ . 772)] (#$ . 6751) battery-load-critical #[0 "\300\207" [10] 1 (#$ . 772)] (#$ . 6864)] 8)
