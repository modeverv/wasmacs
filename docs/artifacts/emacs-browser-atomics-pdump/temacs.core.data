(defalias 'pr-ps-directory-ps-print #[1027 "\306\303\302\301\300\307\310\311!!%\210\f\203 ␀\204 ␀\312\202!␀\313\n	$,\207" [pr--filename pr--file-regexp pr--dir pr--n-up pr-print-using-ghostscript pr-spool-p pr-set-ps-dir-args pr-prompt pr-prompt-gs "PS print dir" pr-ps-directory-using-ghostscript pr-ps-directory-print] 12 (#$ . 83876) (byte-code "\300\301\302\303!!!\207" [pr-interactive-ps-dir-args pr-prompt pr-prompt-gs "PS print dir"] 4)])#@603 Preview buffer using ghostview.

