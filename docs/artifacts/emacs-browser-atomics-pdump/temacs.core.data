(defalias 'xml-find-file-coding-system #[257 "\211@\300=\203>␀\301 \302\303!\210\304\305\"\216\306\307ed\310#!)\262\311f\312fD\211\313\267\202+␀\314\207\315\207\316\267\2027␀\303\207\315\207\314\207\317\320\"\210\207\321\207" [insert-file-contents coding-system-priority-list set-coding-system-priority utf-8 make-closure #[0 "\301\302\300\"\207" [V0 apply set-coding-system-priority] 3] coding-system-base detect-coding-region t 1 2 #s(hash-table test equal purecopy t data ((254 255) 39 (255 254) 41)) utf-16be-with-signature utf-16le-with-signature #s(hash-table test eq purecopy t data (utf-8 49 undecided 49 utf-16le-with-signature 51 utf-16be-with-signature 53)) warn "File contents detected as %s.\n  Consider adding an xml declaration with the encoding specified,\n  or saving as utf-8, as mandated by the xml specification." undecided] 7 (#$ . 74368)])
