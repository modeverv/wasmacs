(defalias 'write-abbrev-file #[512 "\203␀G\303V\204␀\262\304\305\306\307\"r\211q\210\310\311\"\216\312\313\n!\314\"\211\2039␀\211@\315!\2034␀\316\317\"\210\210A\202#␀\210\320ed\304#\203D␀\321eb\210\322\323	\"c\210\324\317\211\317?\205Y␀\303%+\207" [abbrev-file-name coding-system-for-write abbrev-table-name-list 0 utf-8 generate-new-buffer " *temp*" t make-closure #[0 "\301\300!\205	␀\302\300!\207" [V0 buffer-name kill-buffer] 2] sort copy-sequence #[514 "\300!\300!\231\207" [symbol-name] 5 (#$ . 8845)] abbrev--table-symbols insert-abbrev-table-description nil unencodable-char-position utf-8-emacs format ";;-*-coding: %s;-*-\n" write-region] 9 (#$ . 8351) (byte-code "\301\302\303\304!!#C\207" [abbrev-file-name read-file-name "Write abbrev file: " file-name-directory expand-file-name] 5)])#@82 Save to FILE all the user-level abbrev definitions in current buffer.

