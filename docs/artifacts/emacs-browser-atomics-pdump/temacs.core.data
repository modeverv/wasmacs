(defalias 'ps-mule-plot-composition #[514 "\301\302!\210\303\3048!\305G\306\211W\203sH\305:\203)␀\301\307\310\311!\"!\266\202oH\206\203␀\211\312W\203E␀\313\306\"@A\206\202␀\203Y␀\314\211\315H\262\"\203Y␀\206\202␀\3162~␀\313\306\"\211\205{␀\211@\314@\"\203v␀\317\316A\"\210\210A\202a␀\2620\206\202␀\320I\266\204\321!\204\352␀\322\262H\206\350␀\211\312W\203\252␀\313\306\"@A\206\347␀\203\276␀\314\211\315H\262\"\203\276␀\206\347␀\3162\343␀\313\306\"\211\205\340␀\211@\314@\"\203\333␀\317\316A\"\210\210A\202\306␀\2620\206\347␀\320I\266\204\211\262\211\323H\262\324\"\211\304H\262\325\306U\203\n\315\202\304\\\306\"\306U\203\211\306I\210\202C\211\306I\210\211\315I\210\315U\2035\211\304I\210\202C\211\304\312\245I\210\211\326\312\246I\210\301\302!\210\327!\210\301	\211\326H\262\330=\203g\307\331\211\306H\262	#\202h\332!\210\301\333!\266T\202␀\266\301\334\3268\203\201\335\202\202\336\337#\207" [ps-mule-esc-char ps-output "[" copy-sequence 2 nil 0 format " %d" encode-composition-rule 256 char-table-extra-slot encode-char 1 tag throw t vectorp 63 6 ps-mule-encode-char make-string 3 ps-output-string bdf "/C%02X-%X" "false" "]" " ] " "RLC" "RBC" "\n"] 18 (#$ . 19880)])#@287 Generate PostScript code for plotting characters in the region FROM and TO.

