(defalias 'make-button #[642 "\300\301\302\301%\203␀\303\211A\262\242\211A\262\242#\210\202␀\304\305#\210\306\307\"\2041␀\304\307\310#\210\207" [make-overlay nil t button-put overlay-put button overlay-get category default-button] 9 (#$ . 9315)])#@366 Insert a button with the label LABEL.
