(defalias 'calendar-hebrew-list-yahrzeits #[771 "\306\307!\210\310\211\3118\262\312\313U\203␀\314\315!\266\203\202:\313V\203\206␀\210\211S\316\211@A@\3118\262S\317_\\\311V\203q␀\211\320_\321\\\322\245Z\262\211\313W\203U␀\323!\262S\211\320\246\313U\205k␀\211\324\246\313U?\206k␀\211\325\246\313U\262\203q␀T\266\204\326_\320\245\324\245[\325\245%\266\203\202:\323T!\262\327\211@A@\3118\262S\317_\\\311V\203\331␀\211\320_\321\\\322\245Z\262\211\313W\203\275␀\323!\262S\211\320\246\313U\205\323␀\211\324\246\313U?\206\323␀\211\325\246\313U\262\203\331␀T\266\204\326_\320\245\324\245[\325\245\330\211@A@\3118\262S\317_\\\311V\2034\211\320_\321\\\322\245Z\262\211\313W\203\323!\262S\211\320\246\313U\205.\211\324\246\313U?\206.\211\325\246\313U\262\2034T\266\204&\266\203!\211\3118\262S\331!q\210\332\333!\204Q\333 \210\312\334\335 \210\336!\210\337\340\341\342	!\343!\203n\202o\f\342\312\334#)#!\210\211T\211\262X\203\322\342\344\345\310\346\211E\211\3118\262\312\313U\203\243\314\315!\266\203\202\302\313V\203\210\211S\316\211@A@\3118\262S\317_\\\311V\203\371\211\320_\321\\\322\245Z\262\211\313W\203\335\323!\262S\211\320\246\313U\205\363\211\324\246\313U?\206\363\211\325\246\313U\262\203\371T\266\204\326_\320\245\324\245[\325\245%\266\203\202\302\323T!\262\327\211@A@\3118\262S\317_\\\311V\203a\211\320_\321\\\322\245Z\262\211\313W\203E\323!\262S\211\320\246\313U\205[\211\324\246\313U?\206[\211\325\246\313U\262\203aT\266\204\326_\320\245\324\245[\325\245\330\211@A@\3118\262S\317_\\\311V\203\274\211\320_\321\\\322\245Z\262\211\313W\203\240\323!\262S\211\320\246\313U\205\266\211\324\246\313U?\206\266\211\325\246\313U\262\203\274T\266\204&\266\203!\3118\262\"!!\347\261\210\202zeb\210\350\312!\210\334\266\306\351!\207" [calendar-hebrew-yahrzeit-buffer buffer-read-only buffer-undo-list calendar-hebrew-month-name-array-leap-y