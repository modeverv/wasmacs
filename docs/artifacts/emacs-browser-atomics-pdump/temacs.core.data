(custom-autoload 'mail-citation-hook "sendmail" t)
(defvar mail-citation-prefix-regexp (purecopy "\\([ 	]*\\(\\w\\|[_.]\\)+>+\\|[ 	]*[>|]\\)+") (#$ . 1114510))#@451 Text inserted at end of mail buffer when a message is initialized.
