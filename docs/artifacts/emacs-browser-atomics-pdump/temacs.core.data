(defalias 'diary-list-entries-1 #[771 "	\305\211W\203\215\306\307\211\3108\262\306\305U\203\"␀\311\312!\266\203\202A\305V\203\215␀\210\211S\313\211@A@\3108\262S\314_\\\310V\203x␀\211\315_\316\\\317\245Z\262\211\305W\203\\␀\320!\262S\211\315\246\305U\205r␀\211\321\246\305U?\206r␀\211\322\246\305U\262\203x␀T\266\204\323_\315\245\321\245[\322\245%\266\203\202A\320T!\262\324\211@A@\3108\262S\314_\\\310V\203\340␀\211\315_\316\\\317\245Z\262\211\305W\203\304␀\320!\262S\211\315\246\305U\205\332␀\211\321\246\305U?\206\332␀\211\322\246\305U\262\203\340␀T\266\204\323_\315\245\321\245[\322\245\325\211@A@\3108\262S\314_\\\310V\203;\211\315_\316\\\317\245Z\262\211\305W\203\320!\262S\211\315\246\305U\2055\211\321\246\305U?\2065\211\322\246\305U\262\203;T\266\204&\266\203!\n\f\n&\210\326\211\3108\262\306\305U\203e\311\312!\266\203\202\204\305V\203\320\210\211S\313\211@A@\3108\262S\314_\\\310V\203\273\211\315_\316\\\317\245Z\262\211\305W\203\237\320!\262S\211\315\246\305U\205\265\211\321\246\305U?\206\265\211\322\246\305U\262\203\273T\266\204\323_\315\245\321\245[\322\245%\266\203\202\204\320T!\262\324\211@A@\3108\262S\314_\\\310V\203#\211\315_\316\\\317\245Z\262\211\305W\203\320!\262S\211\315\246\305U\205\211\321\246\305U?\206\211\322\246\305U\262\203#T\266\204\323_\315\245\321\245[\322\245\325\211@A@\3108\262S\314_\\\310V\203~\211\315_\316\\\317\245Z\262\211\305W\203b\320!\262S\211\315\246\305U\205x\211\321\246\305U?\206x\211\322\246\305U\262\203~T\266\204&\266\203T!\262\210T\202␀\266eb\207" [original-date number diary-nonmarking-symbol file-glob-attrs list-only 0 nil diary-list-entries-2 2 user-error "There was no year zero" + 31 4 23 10 abs 100 400 365 - (12 31 -1) calendar-gregorian-from-absolute] 26 (#$ . 25643)])#@104 List of any diary files included in the last call to `diary-list-entries'.
