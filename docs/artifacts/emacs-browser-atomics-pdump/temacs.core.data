(defalias 'set-face-attribute #[642 "\300!\262\204␀\301\202␀\302\211\211\211\303>\203'␀\304	\305N\206#␀	\306\307#\210\203N␀@\310=\203:␀A@\262\202F␀@\311=\203F␀A@\262AA\262\202'␀\204V␀\203\262␀;\203\204␀\312\313\"\203\204␀\210\262\204q␀\314\315\"\262\314\316\"\262\312\317\"\203\204␀\262\211\262;\204\217␀\320=\203\233␀\321	\310\300!	$\210;\204\246␀\320=\203\262␀\321	\311\300!	$\210\205\330␀@\322>\204\317␀\321	@\300\nA@!	$\210AA\262\202\262␀\207" [purecopy 0 nil (0 t) put face-alias face-modified t :family :foundry string-match "\\([^-]*\\)-\\([^-]*\\)" match-string 1 2 "\\`[0-9]*\\'" unspecified internal-set-lisp-face-attribute (:family :foundry)] 14 (#$ . 22850)])#@203 Make the font of FACE be bold, if possible.
