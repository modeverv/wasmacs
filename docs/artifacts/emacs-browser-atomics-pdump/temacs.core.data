(defalias 'pr-ps-directory-print #[1027 "\304\303\302\301\300\305\306!%\210\307!\310\n	$\210\311!\210\206'␀\312!,\207" [pr--filename pr--file-regexp pr--dir pr--n-up pr-set-ps-dir-args pr-prompt "PS print dir" pr-ps-file pr-ps-file-list pr-ps-file-print pr-delete-file] 11 (#$ . 82662) (byte-code "\300\301\302!!\207" [pr-interactive-ps-dir-args pr-prompt "PS print dir"] 3)])#@886 Print directory using PostScript printer or through ghostscript.

