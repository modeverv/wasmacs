(byte-code "\300\301\302\303\304DD\305\306\307\310\311\312\313&	\207" [custom-declare-variable dired-compress-directory-default-suffix funcall function #[0 "\300\207" [nil] 1 (#$ . 21568)] (#$ . 46816) :type (choice (const :tag ".tar.gz" nil) string) :group dired :version "28.1"] 10)
