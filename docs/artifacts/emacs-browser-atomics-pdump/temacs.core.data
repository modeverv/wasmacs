(defalias 'pr-ps-buffer-using-ghostscript #[513 "\203␀	\n\236A\203␀\303\"\207\304\305 \306\307!$\207" [pr-auto-mode major-mode pr-mode-alist pr-ps-mode-using-ghostscript pr-ps-using-ghostscript pr-region-active-symbol pr-region-active-string "PS print GS"] 8 (#$ . 86167) (byte-code "\300\301\302!!\207" [pr-interactive-n-up-file pr-prompt "PS print GS"] 3)])#@601 Print buffer using PostScript printer.

