(defvar menu-bar-project-menu (byte-code "\301\302!\303\304\305#\210\303\306\307#\210\303\310\311#\210\303\312\313#\210\303\314#\210\303\315\316#\210\303\317\320#\210\303\321\322#\210\303\323#\210\303\324\325#\210\303\326\327#\210\303\330\331#\210\303\332\333#\210\303\334\335#\210\303\336#\210\303\337\340#\210\303\341\342#\210\303\343\344#\210\303\345\346#\210\303\347\350#\210\303\351\352#\210\207" [menu-bar-separator make-sparse-keymap "Project" bindings--define-key [project-execute-extended-command] (menu-item "Execute Extended Command..." project-execute-extended-command :help "Execute an extended command in project root directory") [project-query-replace-regexp] (menu-item "Query Replace Regexp..." project-query-replace-regexp :help "Interactively replace a regexp in files belonging to current project") [project-or-external-find-regexp] (menu-item "Find Regexp Including External Roots..." project-or-external-find-regexp :help "Search for a regexp in files belonging to current project or external files") [project-find-regexp] (menu-item "Find Regexp..." project-find-regexp :help "Search for a regexp in files belonging to current project") [separator-project-search] [project-kill-buffers] (menu-item "Kill Buffers..." project-kill-buffers :help "Kill the buffers belonging to the current project") [project-list-buffers] (menu-item "List Buffers" project-list-buffers :help "Pop up a window listing all Emacs buffers belonging to current project") [project-switch-to-buffer] (menu-item "Switch To Buffer..." project-switch-to-buffer :help "Prompt for a buffer belonging to current project, and switch to it") [separator-project-buffers] [project-async-shell-command] (menu-item "Async Shell Command..." project-async-shell-command :help "Invoke a shell command in project root asynchronously in background") [project-shell-command] (menu-item "Shell Command..." project-shell-command :help "Invoke a shell command in project root and catch its output") [p