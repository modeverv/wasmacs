(defalias 'translate-region #[771 "\2119\203␀\211\300N\301!\204␀\302\303\"\210\262\304#\207" [translation-table char-table-p error "Invalid translation table name: %s" translate-region-internal] 7 (#$ . 69357) (byte-code "\301 \302 \303\211G\304\211W\203%␀H:\203!␀\305H@!CB\262T\202	␀\266\211\204/␀\306\307!\210\204>␀\310\311\303\312$\262\202/␀\313!\266\202E\207" [translation-table-vector region-beginning region-end nil 0 symbol-name error "No translation table defined" completing-read "Translation table: " t intern] 9)])#@255 Execute BODY like `progn' with TABLE the current category table.
