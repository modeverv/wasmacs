(defalias 'pr-ps-buffer-preview #[513 "\203␀	\n\236A\203␀\303\"\207\304\305 \306\307!$\207" [pr-auto-mode major-mode pr-mode-alist pr-ps-mode-preview pr-ps-preview pr-region-active-symbol pr-region-active-string "PS preview"] 8 (#$ . 85224) (byte-code "\300\301\302!!\207" [pr-interactive-n-up-file pr-prompt "PS preview"] 3)])#@613 Print buffer using PostScript through ghostscript.

