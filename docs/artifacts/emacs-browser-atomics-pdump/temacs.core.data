(defvar frameset-session-filter-alist (byte-code "\301\302\303\304\"\"\207" [frame-internal-parameters append ((left . frameset-filter-iconified) (minibuffer . frameset-filter-minibuffer) (top . frameset-filter-iconified)) mapcar #[257 "\211\300B\207" [:never] 3 (#$ . 519316)]] 5) (#$ . 519174))#@116 Parameters to filter for persistent framesets.
