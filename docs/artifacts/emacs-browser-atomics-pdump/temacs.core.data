(defalias 'diary-entry-time #[257 "\302\303\304\"\203␀\305\306\307\"!\310_\305\306\311\"!\\\202k␀\303\312\"\203?␀\305\306\307\"!\313\246\310_\311\224H\227\314=\203:␀\315\202;␀\316\\\202k␀\303\317\"\203j␀\305\306\307\"!\313\246\310_\305\306\311\"!\\\320\224H\227\314=\203e␀\315\202f␀\316\\\202k␀	)\207" [case-fold-search diary-unknown-time nil string-match "\\`[ 	\n]*\\([0-9]?[0-9]\\)[:.]?\\([0-9][0-9]\\)\\(\\>\\|[^ap]\\)" string-to-number match-string 1 100 2 "\\`[ 	\n]*\\([0-9]?[0-9]\\)\\([ap]\\)m\\>" 12 97 0 1200 "\\`[ 	\n]*\\([0-9]?[0-9]\\)[:.]\\([0-9][0-9]\\)\\([ap]\\)m\\>" 3] 6 (#$ . 61590)])#@48 Return t if E1 is earlier than E2.

