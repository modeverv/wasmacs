(defalias 'calendar-iso-to-absolute #[257 "\211A@\300\301\211\211\3028\262E\211\3028\262\303\304U\203#␀\305\306!\266\203\202B\304V\203\216␀\210\211S\307\211@A@\3028\262S\310_\\\302V\203y␀\211\311_\312\\\313\245Z\262\211\304W\203]␀\314!\262S\211\311\246\304U\205s␀\211\315\246\304U?\206s␀\211\316\246\304U\262\203y␀T\266\204\317_\311\245\315\245[\316\245%\266\203\202B\314T!\262\320\211@A@\3028\262S\310_\\\302V\203\341␀\211\311_\312\\\313\245Z\262\211\304W\203\305␀\314!\262S\211\311\246\304U\205\333␀\211\315\246\304U?\206\333␀\211\316\246\304U\262\203\341␀T\266\204\317_\311\245\315\245[\316\245\321\211@A@\3028\262S\310_\\\302V\203<\211\311_\312\\\313\245Z\262\211\304W\203 \314!\262S\211\311\246\304U\2056\211\315\246\304U?\2066\211\316\246\304U\262\203<T\266\204&\266\203\322\\\"@S\323_\\\304U\203U\324\202WS\\\207" [calendar-dayname-on-or-before 1 2 nil 0 user-error "There was no year zero" + 31 4 23 10 abs 100 400 365 - (12 31 -1) 3 7 6] 21 (#$ . 84)])#@560 Compute the "ISO commercial date" corresponding to the absolute DATE.
The ISO year corresponds approximately to the Gregorian year, but weeks
start on Monday and end on Sunday.  The first week of the ISO year is the
first such week in which at least 4 days are in a year.  The ISO commercial
date has the form (week day year) in which week is in the range 1..52 and
