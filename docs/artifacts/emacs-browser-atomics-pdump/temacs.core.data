rtial "mm-partial" (#$ . 834915) ("mm-partial-find-parts") mm-url-insert-file-contents "mm-url" (#$ . 835148) mm-url-insert-file-contents-external (#$ . 835251) ("mm-url-") "mm-util" ("mm-") mm-uu-dissect "mm-uu" (#$ . 835319) mm-uu-dissect-text-parts (#$ . 835585) ("mm-") "mm-view" ("mm-") mml-to-mime "mml" (#$ . 835724) mml-attach-file (#$ . 835777) ("mime-to-mml" "mml-") "mml-sec" ("mml-") "mml-smime" ("mml-smime-") mml1991-encrypt "mml1991" (#$ . 836632) mml1991-sign (#$ . 836664) ("mml1991-") mml2015-decrypt "mml2015" (#$ . 836681) mml2015-decrypt-test (#$ . 836681) mml2015-verify (#$ . 836681) mml2015-verify-test (#$ . 836681) mml2015-encrypt (#$ . 836632) mml2015-sign (#$ . 836664) mml2015-self-encrypt ("mml2015-") "srecode/mode" ("srecode-") "semantic/decorate/mode" ("define-semantic-decoration-style" "semantic-") put define-overloadable-function doc-string-elt 3 "mode-local" ("def" "describe-mode-local-bindings" "fetch-overload" "get-mode-local-parent" "make-obsolete-overload" "mode-local-" "setq-mode-local" "with-mode-local" "xref-mode-local-") modula-2-mode m2-mode] 5)#@107 Convert plain text in region to Morse code.
