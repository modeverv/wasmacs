(defvar cvs-global-menu (byte-code "\300\301!\302\303\304\305\306!\307\310\305\311!\257#\210\302\312\304\305\313!\314\310\305\315!\257#\210\302\316\304\305\317!\320\310\305\321!\257#\210\302\322\304\305\323!\324\310\305\325!\257#\210\326M\207" [make-sparse-keymap "PCL-CVS" define-key [status] menu-item purecopy "Directory Status" cvs-status :help "A more verbose status of a workarea" [checkout] "Checkout Module" cvs-checkout "Check out a module from the repository" [update] "Update Directory" cvs-update "Fetch updates from the repository" [examine] "Examine Directory" cvs-examine "Examine the current state of a workarea" cvs-global-menu] 10) (#$ . 954332))#@235 Perl backend for Flymake.
