(defalias 'allout-encrypted-type-prefix #[256 "\205␀\203␀\301!\202␀\302 \230\207" [allout-topic-encryption-bullet allout-get-prefix-bullet allout-get-bullet] 4 (#$ . 111364)])#@95 Return outline topic bullet suited to optional DEPTH, or current depth.

