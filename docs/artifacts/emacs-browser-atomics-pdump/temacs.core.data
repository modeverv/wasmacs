#@339 Return the help-echo string at point.
Normally, the string produced by the `help-echo' text or overlay
property, or nil, is returned.
If KBD is non-nil, `kbd-help' is used instead, and any
`help-echo' property is ignored.  In this case, the return value
can also be t, if that is the value of the `kbd-help' property.

(fn &optional KBD)
(custom-declare-group 'help-at-pt nil "Features for displaying local help." :group 'help :version "22.1")
(defalias 'help-at-pt-string #[256 "\212\211\203	␀\300\202\n␀\301\302`\"\211@\203␀\211\202#␀o?\205#␀\303u\210\302`\"\211@A\304!\203:␀\305 \2065␀p`#\202=␀\306!)\207" [kbd-help help-echo get-char-property-and-overlay -1 functionp selected-window eval] 10 (#$ . 84)])#@214 Return the keyboard help string at point.
