(defalias 'sgml-xml-auto-coding-function #[257 "`\\\262\302\303\304#\205\220␀\212\302\305\304#)\211\205\216␀\302\306\304#\203l␀\307\310!\211\227\211\311\267\2023␀\312\2024␀\313\2024␀\211\314!\315!\203f␀\316!\316!	\203c␀\317=\204c␀\320=\204c␀\321\322\"\203c␀\321\322\"\203c␀\207\266\207\323\324\"\325\207\326 \327\322!\210\330\331\"\216\332\333e\304#!)\262\211\334>\203\211␀\322\207\335\336\"\210\262\207" [buffer-file-coding-system enable-multibyte-characters re-search-forward "\\`[[:space:]\n]*<\\?xml" t "[\"']\\s-*\\?>" "encoding=[\"']\\(.+?\\)[\"']" match-string 1 #s(hash-table test equal purecopy t data ("utf-16le" 43 "utf-16be" 47)) "utf-16-le" "utf-16-be" intern coding-system-p coding-system-type charset iso-2022 coding-system-equal utf-8 message "Warning: unknown coding system \"%s\"" nil coding-system-priority-list set-coding-system-priority make-closure #[0 "\301\302\300\"\207" [V0 apply set-coding-system-priority] 3] coding-system-base detect-coding-region (utf-8 utf-8-with-signature utf-8-hfs undecided) warn "File contents detected as %s.\n  Consider adding an encoding attribute to the xml declaration,\n  or saving as utf-8, as mandated by the xml specification."] 12 (#$ . 71737)])#@144 If the buffer has an HTML meta tag, use it to determine encoding.
This function is intended to be added to `auto-coding-functions'.

