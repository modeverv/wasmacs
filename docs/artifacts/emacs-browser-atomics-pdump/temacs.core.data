(defalias 'strokes-execute-stroke #[257 "\304\"\211@A\203␀\211	X\203␀\305\306\"\210\307!\207\2045␀\310\n!\2031␀\311\312\313\n\"!\2059␀\314 \207\315\316!\207\"\207" [strokes-global-map strokes-minimum-match-score strokes-file strokes-no-match-function strokes-match-stroke message "%s" command-execute file-exists-p y-or-n-p format-message "No strokes loaded.  Load `%s'? " strokes-load-user-strokes error "No strokes defined; use `strokes-global-set-stroke'"] 8 (#$ . 21003)])#@115 Read a simple stroke from the user and then execute its command.
