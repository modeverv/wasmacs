#@30 Face for emoji list headers.
(byte-code "\300\301!\210\300\302!\210\300\303!\210\300\304!\210\300\305!\210\306\307\310\311\312\313\314\315&\207" [require cl-lib cl-extra transient multisession generate-lisp-file custom-declare-group emoji nil "Inserting Emojis." :version "29.1" :group play] 8)
(custom-declare-face 'emoji-list-header '((default :weight bold :inherit variable-pitch)) '(#$ . 83) :version "29.1")#@37 Face used when displaying an emoji.
(custom-declare-face 'emoji '((t :height 2.0)) '(#$ . 502) :version "29.1")#@40 Face for emojis that have derivations.
(custom-declare-face 'emoji-with-derivations '((((background dark)) (:background "#202020" :inherit emoji)) (((background light)) (:background "#e0e0e0" :inherit emoji))) '(#$ . 619) :version "29.1")#@263 Alist of emojis and lists of alternate names for the emojis.
Each element in the alist should have the emoji (as a string) as
the first element, and the rest of the elements should be strings
representing names.  For instance:

  ("🤗" "hug" "hugging" "kind")
(defvar emoji-alternate-names nil (#$ . 864))
(defvar emoji--labels nil)
(defvar emoji--all-bases nil)
(defvar emoji--derived nil)
(defvar emoji--names (make-hash-table :test 'equal))
