(custom-declare-face 'isearch-fail '((((class color) (min-colors 88) (background light)) (:background "RosyBrown1")) (((class color) (min-colors 88) (background dark)) (:background "red4")) (((class color) (min-colors 16)) (:background "red")) (((class color) (min-colors 8)) (:background "red")) (((class color grayscale)) :foreground "grey") (t (:inverse-video t))) '(#$ . 12631) :version "23.1")#@406 Controls the lazy-highlighting during incremental search.
