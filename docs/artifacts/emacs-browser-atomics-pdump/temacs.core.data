(byte-code "\300\301!\210\300\302!\210\300\303!\210\300\304!\210\300\305!\210\306\307\310\311\312\313%\207" [require backtrace macroexp cl-lib seq debug custom-declare-group edebug nil "A source-level debugger for Emacs Lisp." :group lisp] 6)
