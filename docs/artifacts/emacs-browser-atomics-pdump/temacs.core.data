(defalias 'find-or #[257 "\211G\300W\203\f␀\301@!\207\302\303\301\304#\305Q\207" [2 find-to-string "\\( " mapconcat "-or " "\\) "] 6 (#$ . 2199)])#@276 Or FORMs together and prefix with a -not, so:
