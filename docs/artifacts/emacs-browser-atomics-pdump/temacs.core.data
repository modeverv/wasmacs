(defvar cjk-char-width-table-list '((ja_JP nil (japanese-jisx0208 (8481 . 10366)) (cp932-2-byte (33088 . 34719))) (zh_CN nil (chinese-gb2312 (8481 . 10622))) (zh_HK nil (big5-hkscs (41280 . 41982) (50848 . 51454))) (zh_TW nil (big5 (41280 . 41982)) (chinese-cns11643-1 (8481 . 17022))) (ko_KR nil (korean-ksc5601 (8481 . 11390)))))#@151 Update character widths for LOCALE-NAME using `ambiguous-width-chars'.
