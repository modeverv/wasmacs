(defalias 'diary-block #[1798 "\302#\211\3038\262\304\305U\203␀\306\307!\266\203\202<\305V\203\210␀\210\211S\310\211@A@\3038\262S\311_\\\303V\203s␀\211\312_\313\\\314\245Z\262\211\305W\203W␀\315!\262S\211\312\246\305U\205m␀\211\316\246\305U?\206m␀\211\317\246\305U\262\203s␀T\266\204\320_\312\245\316\245[\317\245%\266\203\202<\315T!\262\321\211@A@\3038\262S\311_\\\303V\203\333␀\211\312_\313\\\314\245Z\262\211\305W\203\277␀\315!\262S\211\312\246\305U\205\325␀\211\316\246\305U?\206\325␀\211\317\246\305U\262\203\333␀T\266\204\320_\312\245\316\245[\317\245\322\211@A@\3038\262S\311_\\\303V\2036\211\312_\313\\\314\245Z\262\211\305W\203\315!\262S\211\312\246\305U\2050\211\316\246\305U?\2060\211\317\246\305U\262\2036T\266\204&\266\203\302#\211\3038\262\304\305U\203V\306\307!\266\203\202u\305V\203\301\210\211S\310\211@A@\3038\262S\311_\\\303V\203\254\211\312_\313\\\314\245Z\262\211\305W\203\220\315!\262S\211\312\246\305U\205\246\211\316\246\305U?\206\246\211\317\246\305U\262\203\254T\266\204\320_\312\245\316\245[\317\245%\266\203\202u\315T!\262\321\211@A@\3038\262S\311_\\\303V\203\211\312_\313\\\314\245Z\262\211\305W\203\370\315!\262S\211\312\246\305U\205\211\316\246\305U?\206\211\317\246\305U\262\203T\266\204\320_\312\245\316\245[\317\245\322\211@A@\3038\262S\311_\\\303V\203o\211\312_\313\\\314\245Z\262\211\305W\203S\315!\262S\211\312\246\305U\205i\211\316\246\305U?\206i\211\317\246\305U\262\203oT\266\204&\266\203\211\3038\262\304\305U\203\213\306\307!\266\203\202\252\305V\203\366\210\211S\310\211@A@\3038\262S\311_\\\303V\203\341\211\312_\313\\\314\245Z\262\211\305W\203\305\315!\262S\211\312\246\305U\205\333\211\316\246\305U?\206\333\211\317\246\305U\262\203\341T\266\204\320_\312\245\316\245[\317\245%\266\203\202\252\315T!\262\321\211@A@\3038\262S\311_\\\303V\203I\211\312_\313\\\314\245Z\262\211\305W\203-\315!\262S\211\312\246\305U\205C\211\316\246\305U?\206C\211\317\246\305U\262\203IT\266\204\320_\312\245\316\245[\317\245\322\211@A@\3038\262S\311_\\\303V\203\244\211\312_\313\\\314\245Z\262\211\305W\203\210\315!\262S\211\312\246\305U\205\236\211\316\246\305U?\206\236\211\317\246\305U\262\203\244T\266\204&\266\203X\205\271\211X\205\271	B\207" [date entry diary-make-date 2 nil 0 user-error "There was no year zero" + 31 4 23 10 abs 100 400 365 - (12 31 -1)] 26 (#$ . 70440)])#@484 Diary entry for the Nth DAYNAME after/before MONTH DAY.
