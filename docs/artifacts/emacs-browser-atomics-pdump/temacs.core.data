(defconst battery-linux-proc-apm-regexp "^\\([^ ]+\\) \\([^ ]+\\) 0x\\([[:xdigit:]]+\\) 0x\\([[:xdigit:]]+\\) 0x\\([[:xdigit:]]+\\) 0x\\([[:xdigit:]]+\\) \\(-?[[:digit:]]+\\)% \\(-?[[:digit:]]+\\) \\(.*\\)$" (#$ . 14138))#@664 Get APM status information from Linux (the kernel).
