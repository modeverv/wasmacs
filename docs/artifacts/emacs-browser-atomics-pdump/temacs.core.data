(byte-code "\300\301\302\"\210\300\303\304\"\210\300\305\306\"\210\300\307\310\"\210\311\312\313\314\315$\210\311\316\313\317\315$\210\311\320\313\321\315$\210\311\322\313\323\315$\210\311\324\313\325\315$\210\311\326\313\327\315$\210\311\330\313\331\315$\210\311\332\313\333\315$\210\311\334\313\335\315$\210\311\336\313\337\315$\210\311\340\313\341\315$\210\311\342\313\343\315$\210\311\344\313\345\315$\210\346\347\350\"\210\311\351\313\352\315$\210\311\353\313\354\315$\210\311\355\313\356\315$\210\311\357\313\360\315$\210\311\361\313\362#\210\311\363\313\364\315$\210\311\365\313\366\315$\210\311\367\313\370\315$\210\311\371\313\372\315$\210\311\373\313\374\315$\210\311\375\313\376\315$\210\311\377\313\201@␀\315$\210\311\201A␀\313\201B␀\315$\210\300\313\201C␀\"\210\311\201D␀\201E␀\201F␀\315$\210\311\201G␀\201E␀\201H␀\315$\210\311\201I␀\201E␀\201J␀\315$\210\311\201K␀\201E␀\201L␀\315$\210\311\201M␀\201E␀\201N␀\315$\210\311\201O␀\201E␀\201P␀\315$\210\311\201Q␀\201E␀\201R␀\315$\210\311\201S␀\201E␀\201T␀\315$\210\311\201U␀\201E␀\201V␀\315$\210\311\201W␀\201E␀\201X␀\315$\210\311\201Y␀\201E␀\201Z␀\315$\210\311\201[␀\201E␀\201\\␀\315$\210\311\201]␀\201E␀\201^␀\315$\207" [register-definition-prefixes "ebnf-ebx" ("ebnf-ebx-") "ebnf-iso" ("ebnf-") "ebnf-otz" ("ebnf-") "ebnf-yac" ("ebnf-yac-") autoload ebnf-customize "ebnf2ps" (#$ . 331999) t ebnf-print-directory (#$ . 332035) ebnf-print-file (#$ . 332309) ebnf-print-buffer (#$ . 332577) ebnf-print-region (#$ . 333124) ebnf-spool-directory (#$ . 333294) ebnf-spool-file (#$ . 333568) ebnf-spool-buffer (#$ . 333836) ebnf-spool-region (#$ . 334104) ebnf-eps-directory (#$ . 334338) ebnf-eps-file (#$ . 334591) ebnf-eps-buffer (#$ . 334822) ebnf-eps-region (#$ . 335503) defalias ebnf-despool ps-despool ebnf-syntax-directory (#$ . 336198) ebnf-syntax-file (#$ . 336453) ebnf-syntax-buffer (#$ . 336688) ebnf-syntax-region (#$ . 336740) ebnf-setup (#$ . 336796) ebnf-find-style (#$ . 336836) ebnf-insert-style (#$ . 336970) ebnf-delete-styl