      (if wrapp
	  (unless isearch-forward
	    (setq flist (last flist)))
	(unless isearch-forward
	  (setq flist (reverse flist)))
	(while (not (string= (car flist) cb))
	  (setq flist (cdr flist)))
	(setq flist (cdr flist)))
