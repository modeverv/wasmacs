      (with-current-buffer file-or-buf
        (let ((tempfile (make-temp-file "buffer-content-")))
          (if diff-entire-buffers
              (write-region nil nil tempfile nil 'nomessage)
            (write-region (point-min) (point-max) tempfile nil 'nomessage))
