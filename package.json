{
  "name": "wasmacs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/scripts/serve-app.mjs",
    "build": "node src/build/build-site.mjs",
    "userland:build": "src/userland/build.sh",
    "wasifs": "node tools/scripts/wasifs.mjs",
    "wasifs:list": "node tools/scripts/wasifs.mjs list",
    "wasifs:pack": "node tools/scripts/wasifs.mjs pack",
    "wasifs:unpack": "node tools/scripts/wasifs.mjs unpack",
    "browser:smoke": "node tools/scripts/run-browser-smoke.mjs",
    "browser:smoke:processes": "node tools/scripts/run-browser-smoke.mjs shell persist",
    "test": "node --test tests/runtime/*.test.js && tools/scripts/validate-git-artifact-policy.sh",
    "test:artifacts": "tools/scripts/validate-host-abi.sh && tools/scripts/validate-system-lisp-image.sh && tools/scripts/validate-user-filesystem-image.sh",
    "test:process": "npm run test:process:kernel && npm run test:process:emacs",
    "test:process:kernel": "tests/process/build-test-programs.sh && node tests/process/run-kernel-tests.mjs",
    "test:process:emacs": "node tools/scripts/probe-process-service.mjs",
    "test:ediff": "node tools/scripts/probe-ediff.mjs",
    "browser:smoke:ediff": "node tools/scripts/run-browser-smoke.mjs ediff",
    "test:python": "node tools/scripts/probe-python.mjs",
    "browser:smoke:python": "node tools/scripts/run-browser-smoke.mjs python",
    "browser:smoke:term": "node tools/scripts/run-browser-smoke.mjs term",
    "browser:smoke:init": "node tools/scripts/run-browser-smoke.mjs init",
    "test:git-http": "node tools/scripts/probe-git-http.mjs",
    "test:git-http:transport": "node src/userland/git/test-http.mjs",
    "test:product": "npm run test:xterm-pdump-dired && npm run test:xterm-terminal-profile && npm run test:xterm-clipboard-osc52",
    "test:xterm-pdump-dired": "node tools/scripts/probe-browser-pdump-atomics-dired-without-ls.mjs",
    "test:xterm-terminal-profile": "node tools/scripts/probe-browser-pdump-atomics-terminal-profile.mjs",
    "test:xterm-clipboard-osc52": "node tools/scripts/probe-browser-pdump-atomics-clipboard-osc52.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
